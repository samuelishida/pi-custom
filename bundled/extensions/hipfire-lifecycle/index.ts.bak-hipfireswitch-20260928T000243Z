/**
 * hipfire-lifecycle
 *
 * Release the GPU when you switch away from a hipfire-served model, and bring
 * hipfire back when you switch to one.
 *
 * Why this is needed
 * ------------------
 * hipfire and ollama cannot share a 24 GB GPU. While hipfire holds its weights
 * resident (~18-21 GB for the 27B trunk + dflash draft + KV), switching pi to an
 * ollama model leaves nothing for ollama, which then spills to CPU.
 *
 * hipfire exposes no unload endpoint -- only `/health`, `/v1/models`, `/stats`
 * and `/v1/chat/completions`; everything else 404s. So the only way to release
 * VRAM on demand is to stop the service. The systemd user unit is enabled, so
 * starting it again is one command.
 *
 * Behaviour on `model_select`:
 *   switching away from hipfire -> stop the unit  (frees the GPU)
 *   switching to hipfire        -> start the unit, wait for a resident model
 *
 * Safety
 * ------
 * - Only ever touches `hipfire.service`; no other provider or process.
 * - Refuses to stop while hipfire reports in-flight work (`queue_depth > 0`),
 *   so a running generation is never killed out from under itself.
 * - Never stops on a `restore`-sourced select (session resume); it may only start.
 * - Serialised: one transition is handled at a time.
 * - Every decision is appended to `~/.hipfire/lifecycle.log` so the behaviour can
 *   be audited after the fact (notifications vanish with the terminal).
 *
 * Escape hatch: `/hipfire status | start | stop`.
 */

import { appendFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { homedir } from "node:os";
import { join } from "node:path";
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

const PROVIDER = "hipfire";
const UNIT = "hipfire.service";
const BASE = "http://127.0.0.1:11435";
const LOG = join(homedir(), ".hipfire", "lifecycle.log");

type NotifyLevel = "info" | "warning" | "error";

/** Append one audit line. Never throws, never blocks on a full disk. */
function log(line: string): void {
	try {
		appendFileSync(LOG, `${new Date().toISOString()} ${line}\n`);
	} catch {
		/* logging must never break a model switch */
	}
}

/** Run `systemctl --user <verb> hipfire.service`. Never throws. */
function systemctl(verb: string, timeoutMs: number): { ok: boolean; out: string } {
	try {
		const res = spawnSync("systemctl", ["--user", verb, UNIT], {
			encoding: "utf8",
			timeout: timeoutMs,
		});
		return {
			ok: res.status === 0,
			out: `${res.stdout ?? ""}${res.stderr ?? ""}`.trim(),
		};
	} catch (err) {
		return { ok: false, out: (err as Error).message };
	}
}

/** GET a hipfire JSON endpoint. Returns null when unreachable or non-200. */
async function getJson(path: string, timeoutMs = 2500): Promise<Record<string, any> | null> {
	try {
		const ctrl = new AbortController();
		const timer = setTimeout(() => ctrl.abort(), timeoutMs);
		try {
			const res = await fetch(`${BASE}${path}`, { signal: ctrl.signal });
			if (!res.ok) return null;
			return (await res.json()) as Record<string, any>;
		} finally {
			clearTimeout(timer);
		}
	} catch {
		return null;
	}
}

/**
 * Poll /health until hipfire reports a resident model.
 *
 * The budget has to survive a loader wedge, because that is a real, recurring
 * failure here: the daemon's main thread spins waiting for a GPU completion that
 * never arrives and only a restart clears it (see the loader-wedge note in
 * .agents/learnings/hipfire-pi-long-session-failures.md). The hipfire-watchdog
 * timer detects that in ~50s and does a clean restart, so switching to hipfire
 * can legitimately need: detection (~50s) + restart (~10s) + load (~90-150s).
 * 240s sat exactly on that edge and reported "still prewarming" while the
 * watchdog was mid-heal; 480s clears one full heal cycle.
 *
 * Returns `{ model }` when resident, otherwise the last `loading_model` seen, so
 * the caller can report what was actually happening instead of guessing.
 */
async function waitForModel(maxMs: number): Promise<{ model?: string; loading?: string }> {
	const deadline = Date.now() + maxMs;
	let lastLoading = "";
	while (Date.now() < deadline) {
		const health = await getJson("/health");
		const model = health?.model;
		if (typeof model === "string" && model.length > 0) return { model };
		const loading = health?.loading_model;
		if (typeof loading === "string" && loading.length > 0) lastLoading = loading;
		await new Promise((resolve) => setTimeout(resolve, 2000));
	}
	return { loading: lastLoading };
}

export default function (pi: ExtensionAPI) {
	let transitioning = false;

	// Marker so the extension's presence is provable in a headless run.
	pi.on("session_start", async () => {
		log("session_start (hipfire-lifecycle active)");
	});

	pi.on("model_select", async (event, ctx) => {
		const toHipfire = event.model?.provider === PROVIDER;
		const fromHipfire = event.previousModel?.provider === PROVIDER;
		const desc =
			`${event.previousModel ? `${event.previousModel.provider}/${event.previousModel.id}` : "none"}` +
			` -> ${event.model ? `${event.model.provider}/${event.model.id}` : "none"} (${event.source})`;

		// `previousModel` is undefined on the first selection of a session, which
		// means "nothing was loaded before" -- treat that as "not hipfire", so
		// starting pi straight onto an ollama model still frees the GPU for it.
		const firstSelection = event.previousModel === undefined;
		const enteringHipfire = toHipfire && !fromHipfire;
		const leavingHipfire = !toHipfire && (fromHipfire || firstSelection);

		if (transitioning) {
			log(`skip (busy) ${desc}`);
			return;
		}

		if (!enteringHipfire && !leavingHipfire) {
			log(`skip (no hipfire transition) ${desc}`);
			return;
		}

		transitioning = true;
		const notify = (msg: string, level: NotifyLevel = "info") => {
			try {
				ctx.ui.notify(msg, level);
			} catch {
				/* non-interactive modes have no UI */
			}
		};

		try {
			if (leavingHipfire) {
				// ---- leaving hipfire: release the GPU ----
				const stats = await getJson("/stats");
				if (stats === null) {
					log(`leave: hipfire not running, nothing to free | ${desc}`);
					return;
				}

				const depth = Number(stats.queue_depth ?? 0);
				if (depth > 0) {
					log(`leave: SKIPPED, queue_depth=${depth} | ${desc}`);
					notify(
						`hipfire has ${depth} queued request(s) - not stopping, GPU stays held`,
						"warning",
					);
					return;
				}

				const stopped = systemctl("stop", 120_000);
				log(`leave: stop ${stopped.ok ? "ok" : `FAILED (${stopped.out})`} | ${desc}`);
				notify(
					stopped.ok
						? "hipfire stopped - GPU released for ollama"
						: `hipfire stop failed: ${stopped.out}`,
					stopped.ok ? "info" : "error",
				);
				return;
			}

			// ---- entering hipfire: make sure it is up ----
			// Decide from /health, not from the unit state: `systemctl is-active`
			// reports "active" for a unit whose server is holding a wedged load, and
			// waiting on that would burn the whole budget on a daemon the watchdog is
			// about to kill. Only start when there is no model AND nothing loading.
			const before = await getJson("/health");
			const noModel = before === null || typeof before.model !== "string";
			const noLoad = before === null || typeof before.loading_model !== "string";
			if (noModel && noLoad && systemctl("is-active", 10_000).out !== "active") {
				const started = systemctl("start", 300_000);
				if (!started.ok) {
					log(`enter: start FAILED (${started.out}) | ${desc}`);
					notify(`hipfire start failed: ${started.out}`, "error");
					return;
				}
			}

			const { model, loading } = await waitForModel(480_000);
			log(
				`enter: ${model ? `ready (${model})` : `NOT ready (loading=${loading || "none"})`} | ${desc}`,
			);
			if (model) {
				notify(`hipfire ready: ${model}`, "info");
			} else if (loading) {
				notify(
					`hipfire is stuck loading ${loading} - the watchdog restarts the unit when the loader wedges; retry in a minute`,
					"warning",
				);
			} else {
				notify(
					"hipfire is up but nothing is loading and no model is resident - the watchdog will warm it; retry in a minute",
					"warning",
				);
			}
		} catch (err) {
			log(`ERROR ${(err as Error).message} | ${desc}`);
			notify(`hipfire-lifecycle: ${(err as Error).message}`, "error");
		} finally {
			transitioning = false;
		}
	});

	pi.registerCommand("hipfire", {
		description: "Control the hipfire server: status | start | stop",
		handler: async (args, ctx) => {
			const notify = (msg: string, level: NotifyLevel = "info") => {
				try {
					ctx.ui.notify(msg, level);
				} catch {
					/* no UI in json/print modes */
				}
			};
			const verb = (args ?? "").trim() || "status";

			if (verb === "status") {
				const health = await getJson("/health");
				if (!health) {
					const active = systemctl("is-active", 10_000).out;
					notify(`hipfire: not responding (unit: ${active || "unknown"})`, "warning");
					return;
				}
				const stats = await getJson("/stats");
				notify(
					`hipfire: ${health.model ?? "(no model resident)"} | ` +
						`queue ${stats?.queue_depth ?? "?"} | ` +
						`${stats?.recent_tok_s ?? "?"} tok/s | up ${stats?.uptime_sec ?? "?"}s`,
					"info",
				);
				return;
			}

			if (verb === "start" || verb === "stop") {
				const res = systemctl(verb, verb === "start" ? 300_000 : 120_000);
				log(`command /hipfire ${verb}: ${res.ok ? "ok" : res.out}`);
				notify(
					res.ok ? `hipfire ${verb}: ok` : `hipfire ${verb} failed: ${res.out}`,
					res.ok ? "info" : "error",
				);
				return;
			}

			notify("usage: /hipfire status | start | stop", "warning");
		},
	});
}
