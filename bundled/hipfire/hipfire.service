[Unit]
Description=hipfire OpenAI-compatible server (int8 q8 KV, 160K ctx, gfx1100)
Documentation=https://github.com/warpfront/hipfire
After=network-online.target

[Service]
# `hipfire serve -d` daemonises and writes a JSON record ({pid,start_time,...})
# to ~/.hipfire/serve.pid, which systemd's PIDFile= cannot parse. So: start it
# detached, then translate that JSON into a plain PID file via serve-pid.sh.
# Do NOT inline that python here: systemd strips \" in ExecStart, which silently
# produced `expanduser(~/.hipfire/serve.pid)` and failed the unit with SyntaxError
# even though the server itself had started correctly.
Type=forking
PIDFile=%t/hipfire.pid
RemainAfterExit=no
# If a stale daemon survives ExecStop, the new serve refuses to start with
# "FATAL: hipfire daemon already running (PID N)". ExecStop's `hipfire stop
# --force` normally reaps it; RecoveryCommand below is the belt-and-braces path.
ExecStartPre=/home/smk/.hipfire/bin/serve-preclean.sh
# Model weights live on the exFAT SSD; keep this in sync with ~/.bashrc.
Environment=HIPFIRE_MODELS_DIR=/media/smk/Models/hipFire
Environment=HIPFIRE_ROCM_PATH=/opt/rocm
# --- speculative decoding (DFlash draft) ---
# speculation.mode is the canonical selector. It was pinned to "off" here, which
# disabled speculation regardless of the per-arm policy below.
Environment=HIPFIRE_SPECULATION=dflash
# speculation.dflash ("DFlash eligibility policy") has a built-in default of
# "off", and dflash_mode=off is a HARD daemon-side override that skips loading
# the draft entirely even when a draft path is supplied. "auto" loads it when a
# sidecar/draft path is resolvable.
Environment=HIPFIRE_DFLASH_MODE=auto
# The registry entry for qwen3.8:27b-mq4-xt carries no paired draft sidecar, so
# pin it explicitly. Non-empty wins over params.draft; explicitly EMPTY opts out.
# mq4 is the draft the known-good run used (block=8, tau up to 12 -> ~206 tok/s).
Environment=HIPFIRE_DFLASH_DRAFT=/media/smk/Models/hipFire/qwen38-27b-dflash-mq4.hfq
# gfx11 iu4-direct MMQ prefill: +7.6% at 88K, +32% at short prefills.
Environment=HIPFIRE_GFX11_MQ4V2_IU4=1
ExecStart=/bin/bash -c '/home/smk/.hipfire/bin/hipfire serve qwen3.8:27b-mq4-xt 127.0.0.1 11435 -d --kv-mode q8 --idle-timeout 0 && sleep 1 && /home/smk/.hipfire/bin/serve-pid.sh > %t/hipfire.pid'
ExecStop=/home/smk/.hipfire/bin/hipfire stop --force
ExecStopPost=/bin/rm -f %t/hipfire.pid
TimeoutStartSec=1800
TimeoutStopSec=120

[Install]
WantedBy=default.target